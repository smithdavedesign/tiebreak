{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "echo 'tiebreak runs on Cloudflare Workers; this Vercel project only redirects there (GROWTH.md 2026-11-08)'",
  "outputDirectory": "vercel-redirect",
  "redirects": [
    {
      "source": "/:path(.*)",
      "destination": "https://tiebreak.1426davejobs.workers.dev/:path",
      "permanent": true
    }
  ]
}
